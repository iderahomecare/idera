  <link rel="stylesheet" href="styles.css">
  <style>
    /* IDERA brand colours and an always-visible hamburger navigation */
    :root {
      --purple: #39234f;
      --plum: #513365;
      --gold: #c5a46a;
      --cream: #fbf8f2;
      --ink: #302a35;
      --muted: #706977;
    }
    body { background:#fff; }
    .site-header { position:sticky; top:0; z-index:50; }
    .menu-toggle {
      display:inline-flex !important;
      align-items:center; justify-content:center;
      width:48px; height:44px; border:1px solid var(--gold);
      border-radius:4px; color:var(--purple); background:#fff;
      font-size:27px; cursor:pointer;
    }
    .site-header nav {
      display:none; position:absolute; top:100%; right:5%; left:auto;
      width:min(320px,90vw); padding:14px;
      background:#fff; border:1px solid #eee5d8; border-top:3px solid var(--gold);
      box-shadow:0 14px 35px #25152b20; border-radius:0 0 8px 8px;
      flex-direction:column; align-items:stretch; gap:0;
    }
    .site-header nav.open { display:flex; }
    .site-header nav a { display:block; padding:12px 14px; border-bottom:1px solid #f0ebf1; }
    .site-header nav a:last-child { border-bottom:0; }
    .site-header nav a.nav-cta { margin-top:8px; text-align:center; }
    .hero { background:linear-gradient(110deg,#fbf8f2 55%,#eee5f1); }
    .hero-art { background:linear-gradient(145deg,#d9c8b4,#eee4f1); }
    .section-kicker { color:#a08049; }
    .purpose { background:var(--purple); }
    .value-grid article, .feature-grid article { border-radius:5px; }
    .value-grid b { color:var(--gold); }
    .contact-details p { margin:10px 0; }
    .contact-details a { color:var(--plum); text-decoration:underline; text-decoration-color:var(--gold); }
    .contact form button { width:max-content; }
    .form-note { font-size:12px; color:var(--muted); }
    .booking-band { background:var(--cream); text-align:center; padding:55px 7%; }
    .booking-band h2 { color:var(--purple); font-family:'Playfair Display',serif; font-size:clamp(30px,4vw,42px); }
    .booking-band p { max-width:650px; margin:0 auto 22px; color:var(--muted); }
    .faq-list { max-width:900px; }
    .faq-list details { padding:18px 0; border-bottom:1px solid #e9e1e9; }
    .faq-list summary { cursor:pointer; color:var(--purple); font-weight:700; }
    .faq-list details p { color:var(--muted); }
    @media(max-width:520px) {
      .site-header { padding:12px 5%; }
      .site-header nav { right:5%; }
    }
  </style>
</head>
